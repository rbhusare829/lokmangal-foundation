PORT=4000
NODE_ENV=development

# DB_DIALECT=sqlite for local dev (no server needed), mysql for production
DB_DIALECT=sqlite
DB_STORAGE=./data/dev.sqlite

# Used only when DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lokmangal_foundation
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

# Seed admin login (used only by `npm run seed`)
SEED_ADMIN_EMAIL=admin@lokmangalfoundation.org
SEED_ADMIN_PASSWORD=change-this-password
